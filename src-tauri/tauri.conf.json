{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioRouter",
  "version": "0.0.32",
  "identifier": "com.audiorouter.desktop",
  "build": {
    "beforeDevCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../tools/run-ui.ps1 -Task dev",
    "beforeBuildCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../tools/run-ui.ps1 -Task build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:5173 https://api.github.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
