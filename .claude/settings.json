{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rustfmt-edited.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting Rust file"
          }
        ]
      }
    ]
  }
}
