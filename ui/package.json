{
  "name": "@audiorouter/ui",
  "private": true,
  "version": "0.0.20",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "test": "vitest run --configLoader runner --exclude \"e2e/**\"",
    "test:coverage": "vitest run --configLoader runner --exclude \"e2e/**\" --coverage",
    "e2e": "cargo build --manifest-path ../Cargo.toml -p audiorouter-control --example e2e_backend --locked && playwright test --config=playwright.config.ts",
    "e2e:production-canvas": "vite build --config vite.canvas-production.config.ts --configLoader runner && playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "@audiorouter/contracts": "file:../contracts",
    "@tauri-apps/api": "2.12.4",
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
