{
  "name": "audiorouter-streamdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Elgato Stream Deck plugin for AudioRouter (local HTTP API).",
  "scripts": {
    "build": "npm run typecheck && rollup -c",
    "test": "vitest run",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit -p tsconfig.json",
    "pack": "npm run build && streamdeck validate com.mrdesjardins.audiorouter.sdPlugin && streamdeck pack com.mrdesjardins.audiorouter.sdPlugin --output dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.2",
    "@elgato/utils": "0.6.1"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.2",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "26.6.5",
    "rollup": "4.64.9",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "5.0.5"
  }
}
