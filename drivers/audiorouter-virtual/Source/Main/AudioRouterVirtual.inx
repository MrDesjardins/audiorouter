[AUDIOROUTERVIRTUAL_SA.NT.Services]
AddService=AudioRouterVirtual,0x00000002,AudioRouterVirtual_Service_Inst

[AudioRouterVirtual_Service_Inst]
DisplayName=%AudioRouterVirtual.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\audioroutervirtual.sys

[AUDIOROUTERVIRTUAL_SA.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; Enabled cables are the first N stable pairs; invalid runtime values fall back to 2.
HKR,,CableCount,0x00010001,2
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"


;======================================================
; WDF
;======================================================
[AUDIOROUTERVIRTUAL_SA.NT.Wdf]
KmdfService = AudioRouterVirtual, AUDIOROUTERVIRTUAL_SA_WdfSect
[AUDIOROUTERVIRTUAL_SA_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

